read_verilog <<EOT
module top(input a, b, output [5:0] y);
and (y[0], a, b);
nand (y[1], a, b);
or (y[2], a, b);
nor (y[3], a, b);
xor (y[4], a, b);
xnor (y[5], a, b);
endmodule
EOT
select -assert-count 1 t:$and a:src=<inlined>:000002.0004-000002.0017 %i
select -assert-count 1 t:$and a:src=<inlined>:000003.0005-000003.0018 %i
select -assert-count 1 t:$or a:src=<inlined>:000004.0003-000004.0016 %i
select -assert-count 1 t:$or a:src=<inlined>:000005.0004-000005.0017 %i
select -assert-count 1 t:$xor a:src=<inlined>:000006.0004-000006.0017 %i
select -assert-count 1 t:$xor a:src=<inlined>:000007.0005-000007.0018 %i
